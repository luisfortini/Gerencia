APP_NAME=GerencIA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gerencia
DB_USERNAME=gerencia_user
DB_PASSWORD=gerencia_pass

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your@email.com
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SANCTUM_EXPIRATION=720

OPENAI_API_KEY=OPENAI_KEY_PLACEHOLDER
IA_TIER=1

CORS_ALLOWED_ORIGINS=http://localhost:5173
EVOLUTION_BASE_URL=https://example.com
EVOLUTION_API_KEY=EVOLUTION_KEY_PLACEHOLDER
EVOLUTION_VERIFY_SSL=false
OPENAI_VERIFY_SSL=false

FILESYSTEM_DISK=public
